# Copy to .env (gitignored) and fill in. Nothing here is needed for read-only pricing.

# Which network the gateway trades on. Required for the gateway; no default.
HL_NETWORK=testnet

# Main Hyperliquid account the agent trades for (also used to read your fee tier).
HL_ADDRESS=0x...

# Agent (API) wallet key, created at app.hyperliquid.xyz/API. It can place
# orders for HL_ADDRESS but cannot withdraw. Never use the main wallet key here.
HL_AGENT_KEY=0x...

# Oracle signing key. The gateway only sends orders signed by this key's address.
# Generate one: python -c "from eth_account import Account; a=Account.create(); print(a.key.hex(), a.address)"
COSTWALL_SIGNER_KEY=0x...
